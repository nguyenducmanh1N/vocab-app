{
  "expo": {
    "name": "VocabTopic",
    "slug": "vocab-topic",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "vocabtopic",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon",
      "runtimeVersion": {
        "policy": "appVersion"
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": "Cho phép dùng micro để ghi âm khi luyện nói."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Cho phép chọn ảnh để lọc từ vựng trong ảnh.",
          "cameraPermission": "Cho phép chụp trang sách để lọc từ vựng trong ảnh."
        }
      ],
      "@react-native-community/datetimepicker",
      "expo-sharing"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "657e2637-0242-4008-9f5c-80cd107a6872"
      }
    },
    "owner": "manhnguyen0194",
    "updates": {
      "url": "https://u.expo.dev/657e2637-0242-4008-9f5c-80cd107a6872"
    }
  }
}
